<style>{literal}
#multi_dialog_db_exe_excel-editor{min-height:0!important}#multi_dialog_db_exe_excel-editor:not(.excel-positioned){visibility:hidden}#multi_dialog_db_exe_excel-editor .multi_dialog_scroll{min-height:0!important}#multi_dialog_db_exe_excel-editor .multi_dialog_fixed_bar:empty,#multi_dialog_db_exe_excel-editor .multi_dialog_tab_area:empty{display:none}.excel-editor-form{padding:4px 2px}.excel-editor-form label{display:block;font-size:12px;margin-bottom:10px}.excel-editor-form input:not([type=hidden]),.excel-editor-form select,.excel-editor-form textarea{box-sizing:border-box;width:100%;margin-top:5px;min-width:0}.excel-editor-form textarea{min-height:90px}.excel-editor-form .button_row{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}.excel-editor-form .field_edit h6{margin:0 0 8px}.excel-editor-form .error_message:empty{display:none}.excel-row-menu{display:flex;flex-direction:column;gap:6px}.excel-row-menu button{text-align:left}
{/literal}</style>
<script>{literal}
(function(){const form=document.querySelector('.excel-editor-form');if(!form)return;form.closest('.multi_dialog')?.classList.remove('excel-positioned');form.addEventListener('keydown',e=>{if(e.isComposing)return;if(e.key==='Enter'&&(e.target.tagName!=='TEXTAREA'||e.ctrlKey)){e.preventDefault();form.querySelector('.excel-confirm')?.click();}});setTimeout(()=>{const dialog=form.closest('.multi_dialog');const a=window.fbpExcelAnchor;if(dialog&&a){const w=dialog.offsetWidth,h=dialog.offsetHeight;let left=Math.max(8,Math.min(a.left,innerWidth-w-8));let top=a.bottom+6;if(top+h>innerHeight-8)top=Math.max(8,a.top-h-6);if(innerWidth<600){left=Math.max(8,(innerWidth-w)/2);top=Math.max(8,(innerHeight-h)/2);}dialog.style.left=left+'px';dialog.style.top=(top+scrollY)+'px';}dialog?.classList.add('excel-positioned');form.querySelector('input:not([type=hidden]),textarea,select')?.focus();},120);})();
{/literal}</script>
