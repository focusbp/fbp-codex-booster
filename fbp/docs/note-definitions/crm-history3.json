{
  "version": 1,
  "note": {"name": "crm_history3", "title": "履歴管理３", "parent": "crm_customers3", "list_width": 900, "cascade_delete": true},
  "fields": [
    {"name": "contact_date", "title": "対応日", "type": "date", "required": true, "sample": {"relative_days": [-14, -7, 0]}},
    {"name": "subject", "title": "件名", "type": "text", "max_chars": 150, "required": true, "sample": {"values": ["初回面談", "資料送付", "フォロー連絡"]}},
    {"name": "method", "title": "対応方法", "type": "dropdown", "options": {"0": "面談", "1": "電話", "2": "メール", "3": "その他"}, "sample": {"values": [0, 2, 1]}},
    {"name": "staff", "title": "対応者", "type": "text", "max_chars": 100, "sample": "name"},
    {"name": "result", "title": "対応状況", "type": "dropdown", "options": {"0": "対応中", "1": "完了", "2": "次回対応待ち"}, "sample": {"values": [1, 1, 2]}},
    {"name": "detail", "title": "内容", "type": "textarea", "max_chars": 2000, "sample": {"values": ["ご要望を伺いました。（架空の履歴）", "サービス案内を送付しました。（架空の履歴）", "資料の確認状況を伺い、次回の連絡を予定しました。（架空の履歴）"]}}
  ],
  "screens": {
    "list_on_side": ["contact_date", "subject", "method", "staff", "result"],
    "search": ["subject", "method", "result"],
    "delete": ["contact_date", "subject"]
  }
}
