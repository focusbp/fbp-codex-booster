{
  "version": 1,
  "note": {"name": "crm_customers3", "title": "顧客管理３"},
  "fields": [
    {"name": "name", "title": "顧客名", "type": "text", "max_chars": 150, "required": true, "sample": "company"},
    {"name": "contact_name", "title": "担当者名", "type": "text", "max_chars": 100, "sample": "name"},
    {"name": "email", "title": "メールアドレス", "type": "text", "length": 255, "format_check": "email", "sample": "email"},
    {"name": "phone", "title": "電話番号", "type": "text", "max_chars": 30, "sample": {"value": ""}},
    {"name": "address", "title": "住所", "type": "text", "max_chars": 200, "sample": "address"},
    {"name": "status", "title": "取引状況", "type": "dropdown", "options": {"0": "見込み", "1": "取引中", "2": "休止"}, "sample": {"value": 0}},
    {"name": "registered_on", "title": "登録日", "type": "date", "sample": {"relative_days": [0, 0, 0]}},
    {"name": "memo", "title": "メモ", "type": "textarea", "max_chars": 1000, "sample": {"value": "サンプルデータ（架空）"}}
  ],
  "screens": {
    "list": ["name", "contact_name", "email", "phone", "status"],
    "search": ["name", "contact_name", "status"],
    "delete": ["name", "contact_name"]
  }
}
