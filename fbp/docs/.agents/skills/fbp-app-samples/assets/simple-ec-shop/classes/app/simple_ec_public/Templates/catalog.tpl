<main class="sec sec-storefront"><header class="sec-header"><div><h1>{$shop.shopname|escape}</h1><p>{$shop.description|public_text nofilter}</p></div><button type="button" class="ajax-link sec-cart-fixed" data-class="simple_ec_public" data-function="cart" aria-label="カートを見る" title="カートを見る"><span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span></button></header>{foreach $banners as $banner}<img class="sec-banner-image" src="{$banner|escape}" alt="{$shop.shopname|escape}">{/foreach}<div class="sec-intro">{$shop_intro_html nofilter}</div><div class="sec-groups">{foreach $product_groups as $group}<section class="sec-category-section" data-category="{$group.id|escape}">{if $group.name}<h2 class="sec-category-heading">{$group.name|escape}</h2>{/if}<div class="sec-grid">{foreach $group.products as $p}<section class="sec-card">{if $p.image_url}<img loading="lazy" src="{$p.image_url|escape}" alt="{$p.name|escape}">{/if}<p class="sec-category">{$p.category_name|escape}</p><h2>{$p.name|escape}</h2><p>{$types[$p.type]|escape}</p>{if $p.type == 0 || $p.type == 1}<p class="sec-price">{$p.min_price|number_format}円{if $p.max_price != $p.min_price}〜{$p.max_price|number_format}円{/if}<small>（税別）</small></p>{/if}<div>{$p.detail|public_text nofilter}</div>{if $p.type == 1}<p>{$p.date|date_format:'%Y/%m/%d'} {$p.time|escape}</p>{/if}<form id="sec-product-{$p.id|escape}" class="public-form" onsubmit="return false"><input type="hidden" name="sec_csrf" value="{$sec_csrf|escape}"><input type="hidden" name="product" value="{$p.id|escape}">{if $p.type == 0 || $p.type == 1}<div class="sec-variants">{for $i=1 to 5}{$code="code`$i`"}{$price="price`$i`"}{$stock="zaiko`$i`"}{if $p[$code] != ''}{if !$p.zaiko_check || $p[$stock] > 0}<button type="button" class="ajax-link sec-variant" data-class="simple_ec_public" data-function="add" data-form="sec-product-{$p.id|escape}" data-variant="{$i}"><span>{$p[$code]|escape}</span><span>{$p[$price]|number_format}円（税別）{if $p.zaiko_check} / 残り{$p[$stock]|escape}{/if}</span></button>{else}<p class="sec-sold-out">{$p[$code]|escape}は売り切れました</p>{/if}{/if}{/for}</div>{/if}{if $p.type != 0 && $p.type != 1 && ($p.type != 4 || ($p.teiki_shohin != '' && $p.teiki_getugaku > 0))}<div class="public-form-actions"><button type="button" class="ajax-link" data-class="simple_ec_public" data-function="add" data-form="sec-product-{$p.id|escape}">{if $p.type == 2}問い合わせへ{elseif $p.type == 3}見積依頼へ{elseif $p.type == 4}{$p.teiki_shohin|escape} 月額：{$p.monthly_price_including_tax|number_format}円{else}カートに追加{/if}</button></div>{/if}</form></section>{/foreach}</div></section>{/foreach}</div><div class="sec-intro">{$shop_footer_html nofilter}</div><section class="sec-legal" aria-labelledby="sec-legal-heading">
<h2 id="sec-legal-heading">特定商取引法に基づく表記</h2>
<table class="sec-legal-table"><tbody>
{foreach ['company'=>'販売事業者','daihyo'=>'代表者','address'=>'所在地','tel'=>'電話番号','mail'=>'メールアドレス','oshiharai'=>'お支払い方法','soryo_txt'=>'送料','hikiwatashi_jiki'=>'引渡し時期','hikiwatashi_houhou'=>'引渡し方法','henpin'=>'返品・不良品について'] as $field=>$label}
<tr><th scope="row">{$label|escape}</th><td>{$legal_html[$field] nofilter}</td></tr>
{/foreach}
</tbody></table>
</section></main>
