<main class="sample-public"><h1>単品ショップサンプル</h1><section class="sample-product"><dl><dt>商品名</dt><dd>{$product.name|escape}</dd><dt>価格</dt><dd>{$product.price|number_format}円</dd></dl></section><form id="sample_public_shop" class="public-form" onsubmit="return false;"><input type="hidden" name="token" value="{$token|escape}"><p class="error_message error_token"></p>{foreach $fields as $key=>$field}<div class="public-field">{assign var=input_name value="note_`$key`"}{fields_form_original name=$input_name type=$field.type value="" title=$field.parameter_title options_arr=$field.options}<p class="error_message error_note_{$key|escape}"></p></div>{/foreach}
<div class="public-actions"><button type="button" class="ajax-link button_link" data-class="public_pages" data-function="sample_shop_confirm" data-form="sample_public_shop">内容を確認する</button></div></form></main>